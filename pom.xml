<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.b077as.parsel</groupId>
  <artifactId>parsel</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>parsel</name>
  <description>A clean desktop webmail client for Windows and Linux, built on Jolt.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Released on Maven Central. For unreleased Jolt changes: mvn install -DskipTests in the Jolt repo and use 0.1.0-SNAPSHOT. -->
    <jolt.version>0.5.0</jolt.version>
    <!-- Install and updates (see "Install, updates and the launcher" in CLAUDE.md). Keep the plugin (it bundles the stub) and
         jpack-api on the same release, and launcher/pom.xml's jpack.api.version too: notifyShown needs a stub from 0.1.3 on.
         Do not add a property called jpack.version: it is the jpack plugin's own version parameter and would replace the release version. -->
    <jpack.plugin.version>0.1.3</jpack.plugin.version>
    <jpack.api.version>0.1.3</jpack.api.version>
    <parsel.dev>false</parsel.dev>
    <parsel.smoke>false</parsel.smoke>
    <parsel.demo>false</parsel.demo>
    <parsel.vault>false</parsel.vault>
    <parsel.data></parsel.data>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jolt-core</artifactId>
      <version>${jolt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jolt-win32</artifactId>
      <version>${jolt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jolt-linux</artifactId>
      <version>${jolt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jolt-credentials</artifactId>
      <version>${jolt.version}</version>
    </dependency>
    <!-- Tells the launcher (through the jpack stub) when the window is on screen. Does nothing outside an installed copy. -->
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jpack-api</artifactId>
      <version>${jpack.api.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <!-- IMAP/SMTP (Angus Mail is the Jakarta Mail implementation) -->
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>2.0.5</version>
    </dependency>
    <!-- Local cache of headers, bodies and flags -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
    </dependency>
    <!-- Cleans the HTML of received mail before it is stored -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.23.2</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <!-- An in-memory IMAP/SMTP server for the tests -->
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail-junit5</artifactId>
      <version>2.1.15</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-restricted,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.github.b077as.parsel.App</mainClass>
            </manifest>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <!-- The jar (target/parsel-<version>.jar) has every dependency in it: it is the "app" part of a jpack release, and `java -jar` runs it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>fat-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>io.github.b077as.parsel.App</Main-Class>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <!-- Jakarta Mail finds its protocol providers and file types through these files, one copy per library. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/mailcap</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/mime.types</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/javamail.providers</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/javamail.charset.map</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- mvn compile exec:exec            runs the app with the built UI from src/main/resources/ui
           mvn compile exec:exec -Dparsel.dev=true   loads the Vite dev server instead (npm run dev in frontend/) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-Dparsel.dev=${parsel.dev}</argument>
            <argument>-Dparsel.smoke=${parsel.smoke}</argument>
            <argument>-Dparsel.demo=${parsel.demo}</argument>
            <argument>-Dparsel.vault=${parsel.vault}</argument>
            <argument>-Dparsel.data=${parsel.data}</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>io.github.b077as.parsel.App</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- The self-updating install, built with jpack (settings in src/jpack/jpack.json): a jlink Java runtime shared by the launcher
           and Parsel, the jpack stub (Parsel.exe / the AppImage's AppRun), the install folder and the release files.
             mvn -f launcher/pom.xml clean package     (first: the launcher jar)
             mvn clean package -Pjpack -DskipTests
             -> target/jpack/image/<platform>/ (the install folder), target/jpack/release/ (what a GitHub release carries) -->
      <id>jpack</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.github.b077as</groupId>
            <artifactId>jpack-maven-plugin</artifactId>
            <version>${jpack.plugin.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>package</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
