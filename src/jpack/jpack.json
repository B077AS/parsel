{
  "name": "Parsel",
  "mainClass": "io.github.b077as.parsel.App",

  "updateUrl": "https://github.com/B077AS/parsel/releases/latest/download",
  "policy": "manual",

  "log": false,

  "archive": false,

  "appImageName": "Parsel.AppImage",

  "rawParts": ["app", "launcher"],

  "modules": "java.base,java.compiler,java.desktop,java.logging,java.management,java.naming,java.net.http,java.security.jgss,java.security.sasl,java.sql,java.xml,jdk.charsets,jdk.crypto.ec,jdk.httpserver,jdk.naming.dns,jdk.unsupported",

  "jvmArgs": [
    "--enable-native-access=ALL-UNNAMED"
  ],

  "branding": {
    "icon": "src/main/resources/icon.ico",
    "description": "Parsel",
    "company": "Parsel",
    "product": "Parsel"
  },

  "launcher": {
    "jar": "launcher/target/parsel-launcher.jar",
    "mainClass": "io.github.b077as.parsel.launcher.Boot",
    "jvmArgs": [
      "-XX:+UseSerialGC",
      "-Xms8m",
      "-Xmx128m",
      "-XX:TieredStopAtLevel=1",
      "--enable-native-access=ALL-UNNAMED"
    ]
  }
}
